; AI Office Workspace - optional Windows installer (Inno Setup 6.3 or newer)
;
; The default build (packaging\build.bat) creates setup.exe with the built-in
; wizard in packaging\setup.py. This script is the Inno Setup alternative:
;   packaging\build.bat --inno
;   ISCC.exe packaging\installer.iss
; The PyInstaller output must already exist in packaging\output\AIOfficeWorkspace.

#define AppName "AI Office Workspace"
#define AppVersion "1.0.0"
#define AppPublisher "AI Office Workspace"
#define AppExeName "AIOfficeWorkspace.exe"
#define BuildDir "output\AIOfficeWorkspace"

[Setup]
; Keep this AppId stable: it is how Windows recognises upgrades of the app.
AppId={{7C4E1B90-2F63-4B4A-9C1E-5D8A3B6F0C42}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
AppPublisher={#AppPublisher}
DefaultDirName={autopf}\{#AppName}
DefaultGroupName={#AppName}
DisableProgramGroupPage=yes
; Per-user install: no UAC prompt. Change to "admin" and {autopf} becomes
; "C:\Program Files" if a machine-wide install is required.
PrivilegesRequired=lowest
OutputDir=output
OutputBaseFilename=AI-Office-Workspace-Setup
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
; Generated by packaging/make_icon.py during the build.
SetupIconFile=app.ico
UninstallDisplayName={#AppName}
UninstallDisplayIcon={app}\{#AppExeName}
CloseApplications=yes
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0

[Languages]
Name: "japanese"; MessagesFile: "compiler:Languages\Japanese.isl"

[Tasks]
; Created by default: the setup wizard in packaging\setup.py does the same.
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"

[Files]
Source: "{#BuildDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{group}\{#AppName}"; Filename: "{app}\{#AppExeName}"
Name: "{group}\{cm:UninstallProgram,{#AppName}}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\{#AppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#AppExeName}"; Description: "{cm:LaunchProgram,{#AppName}}"; Flags: nowait postinstall skipifsilent

[UninstallDelete]
; Only the program files are removed. Settings, downloaded files and login
; sessions stay in %APPDATA%\AI Office Workspace and in Documents.
Type: filesandordirs; Name: "{app}"
